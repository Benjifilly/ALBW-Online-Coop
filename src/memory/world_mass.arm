@ Shared Mass identity: r0=batch actor, r1=instance index, r4=world control.
@ Returns r0=record address (or 0) and r1=matching family row (or 0).
@ Pure reads; preserves r4-r11. The family table is generated by the builder
@ from src/foliage_profiles.py: type u16, record size u16, vtable u32,
@ count offset u16, records offset u16; a zero type ends the table.
.syntax unified
.arm
push {r5-r7,lr}
mov r5, r0
mov r6, r1
mov r0, #0
mov r1, #0
ldr r2, [r5, #0x2cc]
ldr r3, [r4, #0x2c]
mov r2, r2, lsr #22
add r3, r3, r2, lsl #2
ldr r2, [r4, #0x30]
cmp r3, r2
bhs mass_none
ldr r3, [r3]
cmp r3, r5
bne mass_none
ldrb r2, [r5, #0x2d7]
cmp r2, #0
bne mass_none
ldr r2, [r5, #0x2d0]
ldr r2, [r2, #8]
ldr r3, [r5]
adr r7, mass_families
mass_scan:
ldrh r12, [r7]
cmp r12, #0
beq mass_none
cmp r12, r2
bne mass_next
ldr r12, [r7, #4]
cmp r12, r3
beq mass_found
mass_next:
add r7, r7, #12
b mass_scan
mass_found:
ldrh r2, [r7, #8]
ldr r2, [r5, r2]
cmp r6, r2
bhs mass_none
cmp r2, #4096
bhi mass_none
ldr r2, [r5, #0x478]
cmp r6, r2
bhs mass_none
ldr r2, [r5, #0x480]
ldr r2, [r2, r6, lsl #2]
cmp r2, #0
beq mass_none
ldrh r2, [r7, #10]
ldr r2, [r5, r2]
cmp r2, #0
beq mass_none
ldrh r3, [r7, #2]
mla r0, r6, r3, r2
mov r1, r7
mass_none:
pop {r5-r7,pc}
.balign 4
mass_families:
MASS_FAMILIES
