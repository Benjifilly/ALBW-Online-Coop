@ Observe MassShrubLight leaving the intact state after its native contact.
@ Hook 23979C in 2395CC, right after bl 238DD4: r4/r5=index, r6=batch,
@ r8=records, [sp+0x20]=attack code. Writes only the world event ring;
@ no gameplay mutation, no native callback except the context check, no VFP.
@ Effect: 0 silent cut, 1 SE_Shrub_BREAK, 2 SE_Shrub_CUT, 3 burn.
.syntax unified
.arm
push {r0-r12,lr}
mrs r0, cpsr
push {r0}
ldr r0, =0x7afffc
ldr r4, [r0]
cmp r4, #0x14000000
blo shrub_return
cmp r4, #0x1c000000
bhs shrub_return
tst r4, #3
bne shrub_return
ldr r0, [r4, #0x64]
cmp r0, #0
bne shrub_return
add r12, r4, #0x1400
blx r12
cmp r0, #1
bne shrub_return
@ Saved native registers: r4 +0x14, r5 +0x18, r6 +0x1C, r8 +0x24.
ldr r5, [sp, #0x1c]
ldr r6, [sp, #0x14]
ldr r0, [sp, #0x18]
cmp r6, r0
bne shrub_return
@ Shared identity (world_mass), then the record must come from native r8.
mov r0, r5
mov r1, r6
add r12, r4, #0x2000
blx r12
cmp r0, #0
beq shrub_return
ldrh r2, [r1]
ldr r3, =321
cmp r2, r3
bne shrub_return
mov r7, r0
ldr r2, [sp, #0x24]
add r3, r6, r6, lsl #3
add r3, r3, r3, lsl #1
add r3, r2, r3, lsl #3
cmp r3, r7
bne shrub_return
ldrb r8, [r7]
@ Native stack of 2395CC: original sp is 0x3C above our frame.
ldrsb r1, [sp, #0x5c]
mov r2, #3
cmp r8, #6
beq shrub_record
mov r2, #2
cmp r8, #1
beq shrub_record
cmp r8, #2
bne shrub_return
mov r2, #0
cmp r1, #1
cmpne r1, #15
moveq r2, #1
cmp r1, #5
cmpne r1, #6
moveq r2, #2
shrub_record:
ldr r0, [r4, #0x58]
ldr r1, [r4, #0x5c]
sub r1, r0, r1
cmp r1, #64
bhs shrub_overflow
and r1, r0, #63
add r3, r4, #0x100
add r3, r3, r1, lsl #5
ldr r1, [r5, #0x2cc]
str r1, [r3, #4]
str r6, [r3, #8]
str r2, [r3, #12]
ldr r1, [r4, #0x34]
str r1, [r3, #0x10]
ldr r1, [r4, #0x38]
str r1, [r3, #0x14]
ldr r1, [r4, #0x24]
str r1, [r3, #0x18]
str r8, [r3, #0x1c]
add r0, r0, #1
str r0, [r3]
str r0, [r4, #0x58]
b shrub_return
shrub_overflow:
mov r0, #1
str r0, [r4, #0x60]
shrub_return:
pop {r0}
msr cpsr_f, r0
pop {r0-r12,lr}
add r0, r4, r4, lsl #3
ldr pc, =0x2397a0
.ltorg
