@ Passive capture of the native, already scaled damage and its AttackRecord.
@ Never creates an impact or writes actor memory. r0=actor,r1=record,r2=damage.
.syntax unified
.arm
push {r4-r10,lr}
mov r4, r3
mov r5, r0
mov r6, r1
mov r7, r2
ldr r0, [r4, #0x94]
ldr r1, [r5, #0x2cc]
cmp r0, r1
moveq r0, #0
streq r0, [r4, #0x94]
beq enemy_return
cmp r7, #0
beq enemy_return
cmp r7, #0x10000
bhs enemy_return
bl 0x400
cmp r0, #0
beq enemy_return
ldr r0, [r4, #0x78]
ldr r1, [r4, #0x7c]
sub r1, r0, r1
cmp r1, #64
bhs enemy_overflow
and r1, r0, #63
add r8, r4, #0x10000
add r8, r8, r1, lsl #7
ldr r1, [r5, #0x2cc]
str r1, [r8, #4]
ldr r1, [r5, #0x2d0]
ldr r1, [r1, #8]
str r1, [r8, #8]
ldrsh r1, [r5, #0x58]
str r1, [r8, #12]
str r7, [r8, #0x10]
add r1, r5, #0x500
ldrsh r2, [r1, #8]
str r2, [r8, #0x14]
ldrsh r2, [r1, #10]
str r2, [r8, #0x18]
ldr r1, [r4, #0x34]
str r1, [r8, #0x1c]
ldr r1, [r4, #0x38]
str r1, [r8, #0x20]
ldr r1, [r4, #0x24]
str r1, [r8, #0x24]
add r1, r5, #8
ldm r1, {r2,r3,r7}
add r1, r8, #0x28
stm r1, {r2,r3,r7}
ldr r2, [r4, #0x74]
str r2, [r8, #0x34]
add r1, r8, #0x38
mov r2, #18
enemy_copy:
ldr r3, [r6], #4
str r3, [r1], #4
subs r2, r2, #1
bne enemy_copy
add r0, r0, #1
str r0, [r8]
str r0, [r4, #0x78]
b enemy_return
enemy_overflow:
mov r0, #1
str r0, [r4, #0x80]
enemy_return:
pop {r4-r10,pc}
.ltorg
