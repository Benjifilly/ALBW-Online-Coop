@ Development render jobs. No packet can select a native address. Entry is used
@ only under the verified owner's heap, with a fixed, fingerprinted allow-list.
.syntax unified
.arm
.fpu vfpv2
push {r4-r8,lr}
sub sp, sp, #24
add r5, r8, #0x110
ldr r0, [r5]
ldr r1, =0x4a4f4231
cmp r0, r1
bne job_return
ldr r6, [r5, #4]
ldr r0, [r5, #8]
cmp r0, r6
beq job_return
ldr r7, [r5, #0xc]
subs r0, r7, #1
cmp r0, #32
bhi job_invalid
ldr r0, [r8, #0x14]
cmp r0, #4
beq job_cleanup_only
ldr r0, =0x709df8
ldr r0, [r0]
ldrb r1, [r0, #0x18]
ldr r2, [r8, #0x1c]
cmp r1, r2
bne job_cleanup_only
ldr r1, [r0, #0x1c]
ldr r2, [r8, #0x20]
cmp r1, r2
beq job_owner_ready
job_cleanup_only:
sub r0, r7, #29
cmp r0, #3
bls job_owner_ready
cmp r7, #2
cmpne r7, #4
cmpne r7, #14
cmpne r7, #19
cmpne r7, #21
cmpne r7, #25
beq job_owner_ready
cmp r7, #8
bne job_invalid
ldr r0, [r5, #0x18]
cmp r0, #0
bne job_invalid
job_owner_ready:
mov r0, #1
str r0, [r5, #0x44]
mov r0, #0
str r0, [r5, #0x40]
cmp r7, #2
bls job_svc
ldr r1, [r5, #0x10]
cmp r1, #0
beq job_call
bl 0x0010983c
str r0, [sp, #20]
job_call:
add r0, r5, #0x28
ldm r0, {r1,r2,r3,r4}
stm sp, {r1,r2,r3,r4}
vldr s0, [r5, #0x24]
ldr r12, =0x692944
sub r0, r7, #3
ldr r12, [r12, r0, lsl #2]
add r0, r5, #0x14
ldm r0, {r0-r3}
blx r12
str r0, [r5, #0x38]
str r1, [r5, #0x3c]
ldr r1, [r5, #0x10]
cmp r1, #0
beq job_done
ldr r1, [sp, #20]
bl 0x0010983c
b job_done
job_svc:
cmp r7, #1
bne job_free
ldr r0, =0x10003
mov r1, #0
mov r2, #0
mov r3, #0x200000
mov r4, #3
b job_svc_call
job_free:
mov r0, #1
ldr r1, [r5, #0x14]
mov r2, #0
mov r3, #0x200000
mov r4, #0
job_svc_call:
svc #1
str r0, [r5, #0x38]
str r1, [r5, #0x3c]
b job_done
job_invalid:
mov r0, #1
str r0, [r5, #0x40]
job_done:
mov r0, #0
str r0, [r5, #0x44]
str r6, [r5, #8]
job_return:
add sp, sp, #24
pop {r4-r8,pc}
.ltorg
