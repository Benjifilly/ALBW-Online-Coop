@ Observe one actor's own reaction routine (capture_hooks.ReactionSite),
@ whose first instruction is replaced: r0 = the actor, its state byte at
@ +STATE. The routine runs first, untouched. Then, when the state changed
@ and no replay is running, the world event ring gets the same record as a
@ signboard: handle, index 0, effect from<<4|to, room, owner, from. The
@ other game replays the routine itself (world_prop).
.syntax unified
.arm
push {r4-r10,lr}
mov r5, r0
ldr r9, =STATE
add r9, r0, r9
ldrsb r6, [r9]
bl reaction_original
push {r0,r1}
ldrsb r8, [r9]
cmp r8, r6
beq reaction_return
ldr r0, =0x7afffc
ldr r4, [r0]
cmp r4, #0x14000000
blo reaction_return
cmp r4, #0x1c000000
bhs reaction_return
tst r4, #3
bne reaction_return
ldr r0, [r4, #0x64]
cmp r0, #0
bne reaction_return
add r12, r4, #0x1400
blx r12
cmp r0, #1
bne reaction_return
@ A catalogued prop whose state byte is this one, and a replicated state.
mov r0, r5
add r12, r4, #0x2400
blx r12
cmp r0, #0
beq reaction_return
ldrh r2, [r1, #2]
add r2, r2, #4
sub r3, r9, r5
cmp r2, r3
bne reaction_return
cmp r8, #15
bhi reaction_return
cmp r6, #0
blt reaction_return
ldr r0, [r1, #8]
mov r2, #1
tst r0, r2, lsl r8
beq reaction_return
and r6, r6, #15
ldr r0, [r4, #0x58]
ldr r1, [r4, #0x5c]
sub r1, r0, r1
cmp r1, #64
bhs reaction_overflow
and r1, r0, #63
add r3, r4, #0x100
add r3, r3, r1, lsl #5
ldr r1, [r5, #0x2cc]
str r1, [r3, #4]
mov r1, #0
str r1, [r3, #8]
orr r1, r8, r6, lsl #4
str r1, [r3, #12]
ldr r1, [r4, #0x34]
str r1, [r3, #0x10]
ldr r1, [r4, #0x38]
str r1, [r3, #0x14]
ldr r1, [r4, #0x24]
str r1, [r3, #0x18]
str r6, [r3, #0x1c]
add r0, r0, #1
str r0, [r3]
str r0, [r4, #0x58]
b reaction_return
reaction_overflow:
mov r0, #1
str r0, [r4, #0x60]
reaction_return:
pop {r0,r1}
pop {r4-r10,pc}
@ The displaced first instruction, then the rest of the routine; it returns
@ here through lr.
reaction_original:
DISPLACED
ldr pc, =RETURN
.ltorg
