@ Persistent room-state service. Independent of the ephemeral world scene.
@ Its manifest contains identities and coordinates, never foreign pointers.
.syntax unified
.arm
b restore_tick
b restore_lawn
b restore_tall
b restore_actor
b restore_drop_guard

restore_tick:
push {r4,lr}
ldr r4, =0x7aff78
ldr r4, [r4]
cmp r4, #0
beq restore_tick_end
ldr r0, [r4, #8]
cmp r0, #0
subne r0, r0, #1
strne r0, [r4, #8]
restore_tick_end:
pop {r4,pc}

@ A received cut must not make another loot/enemy lottery. Its source sends
@ the concrete spawn separately. Only the owned native cut command is gated.
restore_drop_guard:
push {r0-r3,r12,lr}
ldr r0, =0x7afffc
ldr r0, [r0]
cmp r0, #0
beq restore_drop_original
ldr r1, [r0]
ldr r2, =0x574f5231
cmp r1, r2
bne restore_drop_original
ldr r1, [r0, #0x64]
cmp r1, #1
bne restore_drop_original
pop {r0-r3,r12,pc}
restore_drop_original:
pop {r0-r3,r12,lr}
push {r0,r1}
ldr r0, =0x7aff70
ldr r0, [r0]
cmp r0, #0
beq restore_drop_no_loot_service
add r12, r0, #0x1000
add r12, r12, #48
pop {r0,r1}
bx r12
restore_drop_no_loot_service:
pop {r0,r1}
@ Replaced instruction at 2356D4 is supplied by the verified builder.
RESTORE_DROP_ORIGINAL
ldr pc, =0x2356d8

restore_lawn:
push {r0-r12,lr}
mov r0, r6
bl restore_actor
pop {r0-r12,lr}
pop {r3-r11,pc}
restore_tall:
push {r0-r12,lr}
mov r0, r4
bl restore_actor
pop {r0-r12,lr}
pop {r4-r11,pc}

@ All registers, FPSCR and VFP data survive an initialization hook.
restore_actor:
push {r0-r12,lr}
vmrs r0, fpscr
mrs r1, cpsr
push {r0,r1}
vpush {d0-d7}
ldr r4, [sp, #72]
ldr r5, =0x7aff78
ldr r5, [r5]
cmp r5, #0
beq restore_end
ldr r0, [r5]
ldr r1, =0x47525331
cmp r0, r1
bne restore_end
ldr r0, [r5, #4]
cmp r0, #1
bne restore_end
ldr r0, [r5, #8]
cmp r0, #0
beq restore_end
ldr r6, [r5, #0x10]
add r0, r5, #0x10000
cmp r6, r0
addne r0, r5, #0x80000
cmpne r6, r0
bne restore_end
ldr r7, [r6]
tst r7, #1
bne restore_end
ldr r8, [r6, #4]
cmp r8, #8192
bhi restore_end
add r6, r6, #16
ldr r0, =0x08000000
cmp r4, r0
blo restore_end
ldr r0, =0x1f000000
cmp r4, r0
bhs restore_end
ldrb r0, [r4, #0x2d7]
cmp r0, #0
bne restore_end
ldr r0, [r4, #0x2d0]
ldr r9, [r0, #8]
sub r0, r9, #316
cmp r0, #1
bls restore_type_grass
cmp r0, #3
cmpne r0, #4
bne restore_end
ldr r1, =0x6ec2d8
b restore_type_check
restore_type_grass:
ldr r1, =0x6ee60c
restore_type_check:
ldr r0, [r4]
cmp r0, r1
bne restore_end
ldr r10, =0x709df8
ldr r10, [r10]
cmp r10, #0
beq restore_end
vldr s6, restore_epsilon
restore_row:
cmp r8, #0
beq restore_end
ldrb r0, [r10, #0x18]
ldr r1, [r6]
cmp r0, r1
bne restore_next
ldr r0, [r10, #0x1c]
ldr r1, [r6, #4]
cmp r0, r1
bne restore_next
ldr r0, [r6, #8]
cmp r0, r9
bne restore_next
ldrsh r0, [r4, #0x58]
ldr r1, [r6, #12]
cmp r0, r1
bne restore_next
add r0, r4, #8
add r1, r6, #16
bl restore_xyz
cmp r0, #0
beq restore_next
ldr r11, [r6, #28]
ldr r0, [r4, #0x630]
cmp r11, r0
bhs restore_next
ldr r0, [r4, #0x478]
cmp r11, r0
bhs restore_next
ldr r0, [r4, #0x480]
ldr r0, [r0, r11, lsl #2]
cmp r0, #0
beq restore_next
add r0, r0, #4
add r1, r6, #32
bl restore_xyz
cmp r0, #0
beq restore_next
ldr r12, [r4, #0x634]
add r0, r11, r11, lsl #6
add r11, r12, r0, lsl #2
ldrb r0, [r11]
cmp r0, #0
bne restore_next
ldr r0, [r11, #8]
cmp r0, #0
beq restore_next
mov r1, #1
mov r2, #0
ldr r12, =0x4ce9f0
blx r12
ldr r0, [r11, #8]
mov r1, #0
mov r2, #1
ldr r12, =0x4ce9f0
blx r12
sub r0, r9, #316
cmp r0, #1
bhi restore_state
mov r0, #0
ldr r1, [r11, #0x88]
cmp r1, #0
beq restore_shape
ldr r12, =0x4a82dc
blx r12
restore_shape:
mov r0, #0
add r1, r11, #0x20
ldr r12, =0x4a90f8
blx r12
restore_state:
mov r0, #0
strh r0, [r11, #0xe8]
strb r0, [r11, #0x100]
mov r0, #5
strb r0, [r11]
ldr r0, [r5, #0x18]
add r0, r0, #1
str r0, [r5, #0x18]
restore_next:
add r6, r6, #48
sub r8, r8, #1
b restore_row
restore_end:
vpop {d0-d7}
pop {r0,r1}
vmsr fpscr, r0
msr cpsr_f, r1
pop {r0-r12,pc}

restore_xyz:
mov r2, #3
restore_xyz_loop:
vldmia r0!, {s0}
vldmia r1!, {s1}
vsub.f32 s0, s0, s1
vabs.f32 s0, s0
vcmp.f32 s0, s6
vmrs APSR_nzcv, fpscr
movhi r0, #0
bxhi lr
subs r2, r2, #1
bne restore_xyz_loop
mov r0, #1
bx lr
.align 2
restore_epsilon: .word 0x388637bd
.ltorg
