@ OFFLINE prototype, EUR only. No publication/allocator/RPC implementation.
@ Entry replaces CMP r6,#0 at 004F7330. r4=victim, r5=victim+500.
@ Private control starts at entry+1000. One armed command, no implicit retries.
@ All D0-D15/FPSCR/general registers preserved; original CMP is replayed.
.syntax unified
.arm
.fpu vfpv2
push {r0-r12,lr}
mrs r0, cpsr
vmrs r1, fpscr
push {r0,r1}
vpush {d0-d15}
sub r8, pc, #28
add r8, r8, #0x1000
ldr r0, [r8]
ldr r1, =0x31504d49
cmp r0, r1
bne trial_finish
ldr r0, [r8, #4]
cmp r0, #1
bne trial_finish
ldr r0, [r8, #8]
cmp r0, #1
bne trial_finish
ldr r0, [r8, #0x14]
cmp r0, #1
bne trial_finish
ldr r0, [r8, #0x40]
cmp r4, r0
bne trial_finish
str r6, [r8, #0xe4]
mov r7, #7
cmp r6, #0
beq trial_reject
add r0, r4, #0x500
cmp r5, r0
bne trial_reject
tst sp, #7
bne trial_reject
mov r7, #8
ldr r0, [r8, #0x64]
cmp r0, #0
beq trial_reject
sub r0, r0, #1
str r0, [r8, #0x64]
mov r7, #6
ldr r0, [r8, #0x10]
cmp r0, #0
beq trial_reject
ldr r0, [r8, #0xe0]
ldr r1, =0x544e5953
cmp r0, r1
bne trial_reject
ldr r0, [r8, #0xe8]
cmp r0, #1
bne trial_reject
@ The descriptor (+C8) and HitInfo flags (+B0) are one closed captured profile.
bl trial_attack_profile
cmp r0, #0
beq trial_reject
add r1, r8, #0xc8
mov r2, #6
trial_check_profile:
ldr r3, [r0], #4
ldr r12, [r1], #4
cmp r3, r12
bne trial_reject
subs r2, r2, #1
bne trial_check_profile
ldr r3, [r0]
ldr r12, [r8, #0xb0]
cmp r3, r12
bne trial_reject
@ Revalidate manager, actor table and room before dereferencing actors.
mov r7, #1
ldr r0, [r8, #0x18]
bl trial_heap
cmp r0, #0
beq trial_reject
ldr r0, =0x706e20
ldr r9, [r0]
ldr r0, [r8, #0x18]
cmp r9, r0
bne trial_reject
add r0, r9, #0x3d000
add r0, r0, #0xbc0
ldr r10, [r0]
ldr r11, [r0, #8]
ldr r1, [r8, #0x20]
cmp r10, r1
bne trial_reject
ldr r1, [r8, #0x24]
cmp r11, r1
bne trial_reject
mov r0, r10
bl trial_heap
cmp r0, #0
beq trial_reject
mov r0, r11
bl trial_heap
cmp r0, #0
beq trial_reject
subs r0, r11, r10
bls trial_reject
tst r0, #3
bne trial_reject
cmp r0, #0x1000
bhi trial_reject
ldr r0, [r8, #0x1c]
bl trial_heap
cmp r0, #0
beq trial_reject
ldr r0, =0x709df8
ldr r0, [r0]
ldr r1, [r8, #0x1c]
cmp r0, r1
bne trial_reject
ldrb r1, [r0, #0x18]
ldr r2, [r8, #0x28]
cmp r1, r2
bne trial_reject
ldr r1, [r0, #0x1c]
ldr r2, [r8, #0x2c]
cmp r1, r2
bne trial_reject
@ Task mode 0 and the known outdoor-scroll state must both be clear.
mov r7, #2
ldr r0, [r8, #0x30]
bl trial_heap
cmp r0, #0
beq trial_reject
ldr r0, =0x712468
ldr r0, [r0]
ldr r1, [r8, #0x30]
cmp r0, r1
bne trial_reject
ldr r1, [r0]
ldr r2, =0x6ef5d8
cmp r1, r2
bne trial_reject
ldrb r0, [r0, #0x25]
cmp r0, #0
bne trial_reject
@ Author is ONLY the local, registered Player in this deliberately narrow test.
mov r7, #4
ldr r0, [r8, #0x34]
bl trial_heap
cmp r0, #0
beq trial_reject
ldr r0, =0x70fb60
ldr r6, [r0]
mov r0, r6
bl trial_heap
cmp r0, #0
beq trial_reject
ldr r6, [r6, #0x10]
ldr r0, [r8, #0x34]
cmp r6, r0
bne trial_reject
ldr r0, [r6]
ldr r1, =0x6d1a88
cmp r0, r1
bne trial_reject
ldrb r0, [r6, #0x2d7]
cmp r0, #0
bne trial_reject
ldr r1, [r8, #0x38]
cmp r1, #0
beq trial_reject
ldr r0, [r6, #0x2cc]
cmp r0, r1
bne trial_reject
mov r0, r1, lsr #22
add r0, r10, r0, lsl #2
cmp r0, r11
bhs trial_reject
ldr r0, [r0]
cmp r0, r6
bne trial_reject
ldr r0, [r6, #0x600]
ldr r1, [r8, #0x3c]
cmp r0, r1
bne trial_reject
ldr r0, [r6, #0x2d0]
ldr r1, [r8, #0xec]
cmp r0, r1
bne trial_reject
bl trial_profile_pointer
cmp r0, #0
beq trial_reject
ldr r0, [r8, #0xec]
ldr r0, [r0, #8]
cmp r0, #32
bne trial_reject
ldr r0, [r6, #0x614]
ldr r1, [r8, #0xf0]
cmp r0, r1
bne trial_reject
bl trial_heap
cmp r0, #0
beq trial_reject
ldr r0, [r8, #0xf0]
ldrh r0, [r0, #0x42]
mov r7, #2
cmp r0, #0x5f
beq trial_reject
@ A single exact soldier, including placement, native profile and HP epoch.
mov r7, #3
mov r0, r4
bl trial_heap
cmp r0, #0
beq trial_reject
ldr r0, [r4]
ldr r1, [r8, #0x48]
adr r2, trial_targets
mov r3, #__TARGET_PROFILE_COUNT__
trial_find_target_profile:
ldr r12, [r2]
cmp r1, r12
beq trial_target_profile_found
add r2, r2, #12
subs r3, r3, #1
bne trial_find_target_profile
b trial_reject
trial_target_profile_found:
ldr r12, [r2, #4]
cmp r0, r12
bne trial_reject
ldr r12, [r2, #8]
ldr r1, [r8, #0x60]
cmp r1, r12
bne trial_reject
@ The native bit02000000 path performs a second RTTI lookup. The closed
@ registered Player author fails that weapon RTTI; no weapon callback follows.
ldrb r0, [r4, #0x2d7]
cmp r0, #0
bne trial_reject
ldr r1, [r8, #0x44]
cmp r1, #0
beq trial_reject
ldr r0, [r4, #0x2cc]
cmp r0, r1
bne trial_reject
mov r0, r1, lsr #22
add r0, r10, r0, lsl #2
cmp r0, r11
bhs trial_reject
ldr r0, [r0]
cmp r0, r4
bne trial_reject
ldrsh r0, [r4, #0x58]
ldr r1, [r8, #0x4c]
cmp r0, r1
bne trial_reject
ldr r0, [r4, #0x2d0]
ldr r1, [r8, #0x50]
cmp r0, r1
bne trial_reject
bl trial_profile_pointer
cmp r0, #0
beq trial_reject
ldr r0, [r8, #0x50]
ldr r0, [r0, #8]
ldr r1, [r8, #0x48]
cmp r0, r1
bne trial_reject
ldr r0, [r4, #0x4b0]
ldr r1, [r8, #0x54]
cmp r0, r1
bne trial_reject
bl trial_sensitivity_pointer
cmp r0, #0
beq trial_reject
@ Sensitivity of the profile's reaction type: table+E+2*type (sword 5: +18).
bl trial_attack_profile
ldrb r1, [r0, #1]
ldr r0, [r8, #0x54]
add r0, r0, r1, lsl #1
ldrh r0, [r0, #0xe]
ldr r1, [r8, #0xf4]
cmp r0, r1
bne trial_reject
ldr r0, [r4, #0x43c]
ldr r1, [r8, #0x58]
cmp r0, r1
bne trial_reject
bl trial_heap
cmp r0, #0
beq trial_reject
mov r7, #5
ldr r0, [r8, #0x58]
ldr r1, [r0]
cmp r1, #0
bne trial_reject
ldrb r1, [r0, #0x21]
cmp r1, #31
bne trial_reject
mov r7, #9
ldrsh r0, [r5, #8]
ldr r1, [r8, #0x5c]
cmp r0, r1
bne trial_reject
cmp r0, #0
ble trial_reject
str r0, [r8, #0x74]
ldrsh r0, [r5, #10]
ldr r1, [r8, #0x60]
cmp r0, r1
bne trial_reject
@ Claim BEFORE making any native call. Lost acknowledgements never retry it.
mov r0, #2
str r0, [r8, #8]
ldr r0, [r8, #0x38]
str r0, [r8, #0xa8]
add r0, r8, #0xc8
str r0, [r8, #0xac]
mov r0, #1
str r0, [r8, #0x7c]
mov r0, r4
add r1, r8, #0x80
ldr r12, =0x4f822c
blx r12
str r0, [r8, #0x68]
cmp r0, #1
bne trial_observe
@ 4F822C prepares the CANDIDATE at actor+7B4, not the current record.
@ Commit only the exact closed profile, while the current record stays empty.
add r6, r4, #0x700
add r6, r6, #0xb4
bl trial_attack_profile
mov r9, r0
ldrb r1, [r9, #1]
mov r0, #1
mov r0, r0, lsl r1
ldr r1, [r6]
cmp r1, r0
bne trial_observe
ldr r0, [r6, #4]
ldr r1, [r8, #0x38]
cmp r0, r1
bne trial_observe
ldr r0, [r6, #0x38]
ldr r1, [r9, #0x18]
cmp r0, r1
bne trial_observe
add r0, r6, #0x20
mov r1, r9
mov r2, #6
trial_check_candidate:
ldr r3, [r0], #4
ldr r12, [r1], #4
cmp r3, r12
bne trial_observe
subs r2, r2, #1
bne trial_check_candidate
ldr r0, [r8, #0x58]
ldr r0, [r0]
cmp r0, #0
bne trial_observe
@ The native commit performs source lookup/RTTI; no record or HP copy here.
mov r0, #1
str r0, [r8, #0xf8]
mov r0, r4
add r1, r8, #0x80
ldr r12, =0x4f7e64
blx r12
bl trial_mark_replay
trial_observe:
ldr r1, [r8, #0x58]
ldr r0, [r1]
str r0, [r8, #0x6c]
ldrh r0, [r1, #0x30]
str r0, [r8, #0x70]
ldrb r0, [r1, #0x21]
str r0, [r8, #0xfc]
ldrsh r0, [r5, #8]
str r0, [r8, #0x78]
mov r0, #3
str r0, [r8, #8]
b trial_finish
trial_reject:
str r7, [r8, #12]
mov r0, #4
str r0, [r8, #8]
trial_finish:
vpop {d0-d15}
pop {r0,r1}
vmsr fpscr, r1
msr cpsr_fs, r0
pop {r0-r12,lr}
cmp r6, #0
ldr pc, =0x4f7334
trial_heap:
tst r0, #3
bne trial_bad_pointer
cmp r0, #0x08000000
blo trial_bad_pointer
cmp r0, #0x1f000000
movlo r0, #1
movhs r0, #0
bx lr
trial_profile_pointer:
tst r0, #3
bne trial_bad_pointer
cmp r0, #0x100000
blo trial_bad_pointer
ldr r1, =0x7aff00
cmp r0, r1
movlo r0, #1
movhs r0, #0
bx lr
trial_bad_pointer:
mov r0, #0
bx lr
@ r0 = closed profile entry selected by control+118 (desc, flags), or 0.
trial_attack_profile:
ldr r0, [r8, #0x118]
cmp r0, #__ATTACK_PROFILE_COUNT__
movhs r0, #0
bxhs lr
adr r1, trial_profiles
add r0, r1, r0, lsl #5
bx lr
trial_sensitivity_pointer:
cmp r0, #0x08000000
bhs trial_heap
tst r0, #3
bne trial_bad_pointer
ldr r1, =0x5e0000
cmp r0, r1
blo trial_bad_pointer
ldr r1, =0x7afb00
cmp r0, r1
movlo r0, #1
movhs r0, #0
bx lr
@ Optional world observer suppression, owned locally and never a wire pointer.
@ Standalone trials have no world extension and therefore no marker to set.
trial_mark_replay:
ldr r0, =0x7afffc
ldr r0, [r0]
tst r0, #3
bxne lr
cmp r0, #0x14000000
bxlo lr
cmp r0, #0x1c000000
bxhs lr
ldr r1, [r0]
ldr r2, =0x574f5231
cmp r1, r2
bxne lr
ldr r1, [r0, #0x18]
ldr r2, [r8, #0x34]
cmp r1, r2
bxne lr
ldr r1, [r0, #0x24]
ldr r2, [r8, #0x18]
cmp r1, r2
bxne lr
ldr r1, [r8, #0x44]
str r1, [r0, #0x94]
bx lr
.balign 4
@ Captured AttackDescs (24 bytes) + HitInfo flags + pad; index 0 is the sword.
trial_profiles:
__ATTACK_PROFILE_TABLE__
.ltorg
.balign 4
trial_targets:
__TARGET_PROFILE_TABLE__

