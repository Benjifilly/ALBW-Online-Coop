@ Called before EFLK unregister, or on room/owner/lease expiry. All native
@ instances leave the shared pool BEFORE their borrowed tables can disappear.
.syntax unified
.arm
push {r4-r6,lr}
mov r4, r0
add r5, r4, #8
mov r6, #7
retire_bank:
ldr r0, [r5], #4
cmp r0, #0
blne 0x4a1ad8
subs r6, r6, #1
bne retire_bank
ldr r1, [r4, #0x34]
mov r0, #1
str r0, [r1]
mov r0, #0
str r0, [r4]
pop {r4-r6,pc}
