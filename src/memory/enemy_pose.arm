@ Runs original integration first. Only network-listed enemy translations/yaw
@ are adjusted; old position+368, secondary angle+500 and collisions survive.
.syntax unified
.arm
.fpu vfpv2
push {r4-r12,lr}
mov r5, r0
adr lr, pose_original_return
ldr pc, =0x7afff0
pose_original_return:
push {r0-r3,r12,lr}
sub sp, sp, #8
mrs r0, cpsr
str r0, [sp]
vmrs r0, fpscr
str r0, [sp, #4]
vpush {d0-d7}
ldr r4, =0x7afffc
ldr r4, [r4]
cmp r4, #0
beq pose_done
add r12, r4, #0x1400
blx r12
cmp r0, #0
beq pose_done
@ Suspend during native outdoor scroll, even if GameState already changed.
ldr r0, [r4, #0x18]
ldr r0, [r0, #0x614]
cmp r0, #0x08000000
blo pose_done
cmp r0, #0x1f000000
bhs pose_done
tst r0, #3
bne pose_done
ldrh r0, [r0, #0x42]
cmp r0, #0x5f
beq pose_done
ldr r6, [r4, #0x98]
add r0, r4, #0x51000
cmp r6, r0
addne r0, r4, #0x53000
cmpne r6, r0
bne pose_done
ldr r7, [r6]
tst r7, #1
bne pose_done
cmp r7, #0
beq pose_done
ldr r0, [r6, #4]
ldr r1, [r4, #0x74]
sub r0, r1, r0
cmp r0, #12
bhi pose_done
ldr r8, [r6, #8]
cmp r8, #64
bhi pose_done
ldr r1, [r6, #12]
cmp r1, #1
blo pose_done
cmp r1, #6
bhi pose_done
add r0, r0, #1
cmp r0, r1
movhi r0, r1
vmov s0, r0
vcvt.f32.u32 s0, s0
vmov s1, r1
vcvt.f32.u32 s1, s1
vdiv.f32 s0, s0, s1
add r9, r6, #0x20
pose_next:
cmp r8, #0
beq pose_done
ldr r0, [r9, #4]
cmp r0, r5
bne pose_advance
ldr r0, [r9]
mov r1, r0, lsr #22
ldr r2, [r4, #0x2c]
add r2, r2, r1, lsl #2
ldr r1, [r4, #0x30]
cmp r2, r1
bhs pose_done
ldr r1, [r2]
cmp r1, r5
bne pose_done
ldr r1, [r5, #0x2cc]
cmp r1, r0
bne pose_done
ldrb r0, [r5, #0x2d7]
cmp r0, #0
bne pose_done
ldr r0, [r5]
ldr r1, [r9, #8]
cmp r0, r1
bne pose_done
ldr r0, [r5, #0x2d0]
cmp r0, #0x100000
blo pose_done
cmp r0, #0x1f000000
bhs pose_done
tst r0, #3
bne pose_done
ldr r0, [r0, #8]
ldr r1, [r9, #12]
cmp r0, r1
bne pose_done
ldrsh r0, [r5, #0x58]
ldr r1, [r9, #0x10]
cmp r0, r1
bne pose_done
add r0, r5, #0x500
ldrsh r1, [r0, #8]
ldr r2, [r9, #0x14]
tst r2, #0x80000000
beq pose_alive
@ A dying row is valid only after THIS actor's own native HP reached zero.
@ Never pull a locally lethal hit back towards an older live host frame.
cmp r1, #0
bgt pose_done
cmn r1, #64
blt pose_done
b pose_maximum
pose_alive:
cmp r1, #0
ble pose_done
pose_maximum:
ldrsh r0, [r0, #10]
bic r1, r2, #0x80000000
cmp r0, r1
bne pose_done
add r0, r5, #8
add r1, r9, #0x34
mov r2, #3
pose_initial:
ldr r3, [r0], #4
ldr r12, [r1], #4
cmp r3, r12
bne pose_done
subs r2, r2, #1
bne pose_initial
@ Validate and calculate all components before rechecking publication revision.
mov r2, #6
add r0, r9, #0x18
ldr r12, =0x7f800000
pose_finite:
ldr r1, [r0], #4
and r1, r1, r12
cmp r1, r12
beq pose_done
subs r2, r2, #1
bne pose_finite
vldr s1, [r9, #0x18]
vldr s2, [r9, #0x24]
vsub.f32 s2, s2, s1
vmla.f32 s1, s2, s0
vldr s3, [r9, #0x1c]
vldr s4, [r9, #0x28]
vsub.f32 s4, s4, s3
vmla.f32 s3, s4, s0
vldr s5, [r9, #0x20]
vldr s6, [r9, #0x2c]
vsub.f32 s6, s6, s5
vmla.f32 s5, s6, s0
ldr r3, [r9, #0x30]
ldr r0, [r6]
cmp r0, r7
bne pose_done
vstr s1, [r5, #0x3d0]
vstr s3, [r5, #0x3d4]
vstr s5, [r5, #0x3d8]
str r3, [r5, #0x3e8]
ldr r0, [r9, #0x14]
tst r0, #0x80000000
beq pose_done
@ Owned diagnostic only: confirmations of applied dying transforms.
ldr r0, [r4, #0xac]
add r0, r0, #1
str r0, [r4, #0xac]
b pose_done
pose_advance:
add r9, r9, #64
sub r8, r8, #1
b pose_next
pose_done:
vpop {d0-d7}
ldr r0, [sp, #4]
vmsr fpscr, r0
ldr r0, [sp]
msr cpsr_f, r0
add sp, sp, #8
pop {r0-r3,r12,lr}
str r12, [sp, #32]
pop {r4-r12,pc}
.ltorg
