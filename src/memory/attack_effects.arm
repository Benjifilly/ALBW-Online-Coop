@ Optional private particle presenter. r8 remains the verified render mailbox.
@ Installed only with the main hook; all addresses come from local reserves.
.syntax unified
.arm
push {r4-r10,lr}
bl 0x692e00
ldr r4, [r8, #0x1fc]
cmp r4, #0
beq effects_return
@ Block: +0 lease, +4 heap, +8 seven banks, +24 room, +2C count, +30
@ records, +34 retirement flag (see effect_model.publish).
ldr r0, [r4, #0x34]
ldr r0, [r0]
cmp r0, #0
bne effects_return
ldr r1, [r4, #4]
bl 0x10983c
mov r7, r0
ldr r0, [r4]
ldr r1, [r8, #0x14]
cmp r1, #4
moveq r0, #0
cmp r0, #0
beq effects_hide
sub r0, r0, #1
str r0, [r4]
ldr r0, =0x709df8
ldr r0, [r0]
ldrb r1, [r0, #0x18]
ldr r2, [r4, #0x24]
cmp r1, r2
bne effects_hide
ldr r1, [r0, #0x1c]
ldr r2, [r4, #0x28]
cmp r1, r2
bne effects_hide
add r5, r4, #8
mov r6, #7
effects_bank:
ldr r0, [r5], #4
cmp r0, #0
blne 0x4a1ef8
subs r6, r6, #1
bne effects_bank
ldr r5, [r4, #0x2c]
cmp r5, #8
bhi effects_hide
ldr r6, [r4, #0x30]
cmp r5, #0
beq effects_restore_heap
effects_next:
mov r0, r6
bl 0x692d9c
add r6, r6, #56
subs r5, r5, #1
bne effects_next
b effects_restore_heap
effects_hide:
mov r0, r4
bl 0x6929c0
effects_restore_heap:
mov r1, r7
bl 0x10983c
effects_return:
pop {r4-r10,pc}
.ltorg
