@ Every state machine change (65BB50 and its 302 identical copies) stores the
@ new state (+4) and the old one (+5), then tells the owner's animation
@ component through 10BEB4(component, entry) with the machine still in r4.
@ This replaces 10BEB4's first instruction ("mov r2, #1"): for the machine of
@ a catalogued prop (ACTOR_PROPS, not a reaction and not observed by its own
@ hook) whose new state is replicated, the world event ring gets the same
@ record as a signboard: handle, index 0, effect from<<4|to, room, owner,
@ from. Never during a replay. Then 10BEB4 runs from its second instruction.
.syntax unified
.arm
push {r0-r12,lr}
mov r6, r0
@ r4 is a machine only when it is a word-aligned linear-heap object naming
@ this component (+10) and its owner (+14, component = owner + 324).
cmp r4, #0x14000000
blo machine_done
cmp r4, #0x1c000000
bhs machine_done
tst r4, #3
bne machine_done
ldr r0, [r4, #0x10]
cmp r0, r6
bne machine_done
ldr r5, [r4, #0x14]
add r0, r5, #0x324
cmp r0, r6
bne machine_done
mov r8, r4
ldr r0, =0x7afffc
ldr r4, [r0]
cmp r4, #0x14000000
blo machine_done
cmp r4, #0x1c000000
bhs machine_done
tst r4, #3
bne machine_done
ldr r0, [r4, #0x64]
cmp r0, #0
bne machine_done
add r12, r4, #0x1400
blx r12
cmp r0, #1
bne machine_done
mov r0, r5
add r12, r4, #0x2400
blx r12
cmp r0, #0
beq machine_done
@ This prop's own machine, observed here (bits 31 reaction, 30 own hook).
ldrh r2, [r1, #2]
add r2, r5, r2
cmp r2, r8
bne machine_done
ldr r9, [r1, #8]
tst r9, #0xc0000000
bne machine_done
ldrsb r7, [r8, #4]
ldrb r6, [r8, #5]
cmp r7, #15
bhi machine_done
cmp r6, #15
bhi machine_done
cmp r6, r7
beq machine_done
mov r2, #1
tst r9, r2, lsl r7
beq machine_done
ldr r0, [r4, #0x58]
ldr r1, [r4, #0x5c]
sub r1, r0, r1
cmp r1, #64
bhs machine_overflow
and r1, r0, #63
add r3, r4, #0x100
add r3, r3, r1, lsl #5
ldr r1, [r5, #0x2cc]
str r1, [r3, #4]
mov r1, #0
str r1, [r3, #8]
orr r1, r7, r6, lsl #4
str r1, [r3, #12]
ldr r1, [r4, #0x34]
str r1, [r3, #0x10]
ldr r1, [r4, #0x38]
str r1, [r3, #0x14]
ldr r1, [r4, #0x24]
str r1, [r3, #0x18]
str r6, [r3, #0x1c]
add r0, r0, #1
str r0, [r3]
str r0, [r4, #0x58]
b machine_done
machine_overflow:
mov r0, #1
str r0, [r4, #0x60]
machine_done:
pop {r0-r12,lr}
mov r2, #1
ldr pc, =0x10beb8
.ltorg
